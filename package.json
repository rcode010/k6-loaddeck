{
  "name": "k6-loaddeck",
  "displayName": "LoadDeck \u2014 k6 Performance Testing",
  "description": "GUI-first local performance testing powered by Grafana k6.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Testing",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:loaddeck.navigation"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Inspect results in Restricted Mode. Test execution requires workspace trust."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "package": "vsce package --skip-license --no-dependencies",
    "vscode:prepublish": "npm run build",
    "test:host": "node scripts/test-host.mjs",
    "test:vscode:ui": "node scripts/test-vscode-ui.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "loaddeck.open",
        "title": "Open Performance Dashboard",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.quick",
        "title": "Quick Test URL",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.save",
        "title": "Create Test Script",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.runCurrent",
        "title": "Run Current Test File",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.runFile",
        "title": "Run Test File\u2026",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.stop",
        "title": "Stop Running Test",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.history",
        "title": "View Test History",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.compare",
        "title": "Compare Test Results",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.check",
        "title": "Check Installation",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.credential",
        "title": "Store Runtime Credential",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.manageCredentials",
        "title": "Manage Runtime Credentials",
        "category": "LoadDeck"
      },
      {
        "command": "loaddeck.saved",
        "title": "View Saved Tests",
        "category": "LoadDeck"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loaddeck",
          "title": "LoadDeck",
          "icon": "media/loaddeck.svg"
        }
      ]
    },
    "views": {
      "loaddeck": [
        {
          "id": "loaddeck.navigation",
          "name": "Performance Testing"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "loaddeck.runCurrent",
          "when": "resourceExtname == .js",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LoadDeck",
      "properties": {
        "loaddeck.binaryPath": {
          "type": "string",
          "default": "",
          "description": "k6 executable in the extension host environment.",
          "scope": "machine"
        },
        "loaddeck.defaultTestKind": {
          "type": "string",
          "enum": [
            "smoke",
            "load"
          ],
          "default": "smoke"
        },
        "loaddeck.defaultVus": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 10000
        },
        "loaddeck.defaultDuration": {
          "type": "string",
          "default": "10s"
        },
        "loaddeck.historyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "loaddeck.confirmExternalTargets": {
          "type": "boolean",
          "default": true
        },
        "loaddeck.confirmHighLoad": {
          "type": "boolean",
          "default": true
        },
        "loaddeck.scriptEnvironment": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "default": [],
          "description": "Runtime variable names to inject into existing scripts from SecretStorage or the extension host environment. Never store secret values here."
        }
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "ws": "^8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rcode010/k6-loaddeck.git"
  }
}
